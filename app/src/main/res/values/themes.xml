        <!-- Keep this opaque: MediaRouter calculates contrast against this colour. -->
        <item name="colorPrimary">@color/ic_launcher_background</item>
        <item name="colorPrimaryDark">#052F39</item>
        <item name="colorAccent">#0B6A7D</item>
    </style>
</resources>
